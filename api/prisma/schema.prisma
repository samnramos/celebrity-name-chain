generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Game {
  id        Int      @id @default(autoincrement())
  roomCode  String   @unique
  letter    String
  createdAt DateTime @default(now())
  answers   Answer[]
}

model Answer {
  id        Int      @id @default(autoincrement())
  gameId    Int
  username  String
  celebrity String
  createdAt DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
}
